platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# *** Nur EIN post_install – mit TARGET, nicht installer! ***
post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
  end

  installer.pods_project.targets.each do |target|
    # Flutter Build-Settings je Target anwenden
    flutter_additional_ios_build_settings(target)

    # iOS-Deployment-Target für alle Pods hochsetzen
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    end
  end

  # Ensure Flutter build settings are included when Runner uses Pods base configs.
  %w[debug release profile].each do |config|
    xcconfig_path = File.join(
      __dir__,
      'Pods',
      'Target Support Files',
      'Pods-Runner',
      "Pods-Runner.#{config}.xcconfig"
    )
    next unless File.exist?(xcconfig_path)

    include_line = '#include "../../../Flutter/Generated.xcconfig"'
    lines = File.readlines(xcconfig_path)
    unless lines.any? { |line| line.chomp == include_line }
      lines << "\n"
      lines << "#{include_line}\n"
    end

    # CocoaPods regenerates these xcconfigs; keep Xcode quiet for Flutter's quoted framework includes.
    sanitized_lines = []
    quoted_include_warning_written = false
    lines.each do |line|
      key = line.split('=', 2).first.strip
      case key
      when 'ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES', 'EMBEDDED_CONTENT_CONTAINS_SWIFT'
        next
      when 'CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'
        next if quoted_include_warning_written

        sanitized_lines << "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO\n"
        quoted_include_warning_written = true
      else
        sanitized_lines << line
      end
    end
    sanitized_lines.unshift("CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO\n") unless quoted_include_warning_written

    File.write(xcconfig_path, sanitized_lines.join)
  end
end
